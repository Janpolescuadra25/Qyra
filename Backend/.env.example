# ===========================================
# Qyra Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---- QuickBooks OAuth ----
QB_CLIENT_ID=your-qb-client-id
QB_CLIENT_SECRET=your-qb-client-secret
QB_REDIRECT_URI=https://your-app.onrender.com/api/quickbooks/callback
# QB_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
# QB_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# QB_API_BASE_URL=https://quickbooks.api.intuit.com/v3/company
QB_ENVIRONMENT=sandbox

# ---- Database & Auth ----
DATABASE_URL=postgresql://user:password@host:5432/qyra
JWT_SECRET=your-jwt-secret-at-least-32-chars
# JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your-encryption-key-32-bytes

# ---- Application ----
PORT=3005
# NODE_ENV=development
APP_URL=https://api.qyra.space
LANDING_PAGE_URL=https://qyra.space
FRONTEND_URL=https://qyra.space
SENTRY_DSN=
QB_REDIRECT_URI=https://api.qyra.space/api/quickbooks/callback
ALLOWED_EXTENSION_ID=bfhobnahngcmhaeklihifgfbgdepibii

# ---- AI / OCR ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Email (Resend) ----
RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_ADDRESS=noreply@qyra.space

# ---- Stripe ----
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxx
STRIPE_STARTER_ANNUAL_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_xxx
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_xxx
STRIPE_SCAN_PACK_100_PRICE_ID=price_xxx
STRIPE_SCAN_PACK_250_PRICE_ID=price_xxx
STRIPE_SCAN_PACK_500_PRICE_ID=price_xxx

# ---- Storage (Cloudflare R2 / S3-compatible) ----
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# ---- Owner Seed (one-time setup) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=your-secure-password
OWNER_NAME=Qyra Owner
# RESET_OWNER_PASSWORD=true


