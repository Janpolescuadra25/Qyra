generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  password                String?
  role                    UserRole                 @default(VIEWER)
  status                  UserStatus               @default(ACTIVE)
  adminId                 String?
  trialExpiresAt          DateTime?
  customExpiryMessage     String?
  maxUsers                Int?
  createdAt               DateTime                 @default(now())
  welcomedAt              DateTime?
  updatedAt               DateTime                 @updatedAt
  mustChangePassword      Boolean                  @default(false)
  approvedAt              DateTime?
  approvedById            String?
  blocked                 Boolean                  @default(false)
  blockedById             String?
  gracePeriodHours        Int                      @default(48)
  invitedById             String?
  permissions             Json?
  timeBombAt              DateTime?
  transferredFromId       String?
  emailVerified           Boolean                  @default(false)
  currentPeriodEnd        DateTime?
  currentPlan             String?
  planInterval            String?
  stripeCustomerId        String?                  @unique
  stripeSubscriptionId    String?
  subscriptionSource      String?
  cancelAtPeriodEnd       Boolean                  @default(false)
  maxLocations            Int?
  paymentIssue            Boolean                  @default(false)
  maxScans                Int?
  maxStorageBytes         Int?
  managedById             String?
  poolScans               Int?
  poolStorageBytes        Int?
  bonusScans              Int                      @default(0)
  poolLocations           Int?
  poolTemplates           Int?
  maxMembers              Int?
  allocatedScans          Int?
  allocatedStorageBytes   Int?
  allocatedLocations      Int?
  allocatedTemplates      Int?
  brandName               String?
  brandColor              String?
  logoUrl                 String?
  agreementPrice          Decimal?                 @db.Decimal(10, 2)
  agreementDate           DateTime?
  agreementTerms          String?                  @db.Text
  agreementDocUrl         String?
  prioritySupport         Boolean                  @default(false)
  scanHistoryDays         Int?
  approvedRequests        AdminRequest[]           @relation("ApprovedAdminRequests")
  auditLogs               AuditLog[]               @relation("AuditActor")
  auditTargets            AuditLog[]               @relation("AuditTarget")
  emailVerificationTokens EmailVerificationToken[]
  inviteLinks             InviteLink[]             @relation("InviteCreator")
  managedLocations        Location[]               @relation("AdminLocations")
  locations               Location[]               @relation("UserLocations")
  locationAttachments     LocationAttachment[]
  oauthStates             OAuthState[]
  passwordResetTokens     PasswordResetToken[]
  products                Product[]
  qbTokens                QBToken?
  syncLogs                SyncLog[]
  notificationPreferences NotificationPreference?
  admin                   User?                    @relation("AdminUsers", fields: [adminId], references: [id])
  teamMembers             User[]                   @relation("AdminUsers")
  manager                 User?                    @relation("TeamManager", fields: [managedById], references: [id])
  managedMembers          User[]                   @relation("TeamManager")
  approvedBy              User?                    @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedUsers           User[]                   @relation("ApprovedBy")
  submittedScans          ScanRecord[]             @relation("ScanSubmitter")
  approvedScans           ScanRecord[]             @relation("ScanApprover")
  blockedBy               User?                    @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedUsers            User[]                   @relation("BlockedBy")
  invitedBy               User?                    @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUsers            User[]                   @relation("InvitedBy")
  transferredFrom         User?                    @relation("TransferredFrom", fields: [transferredFromId], references: [id])
  transferredTo           User[]                   @relation("TransferredFrom")
  scanPackPurchases       ScanPackPurchase[]

  @@index([blockedById])
  @@index([approvedById])
  @@index([invitedById])
  @@index([transferredFromId])
  @@index([adminId])
  @@index([managedById])
  @@index([adminId, role])
  @@map("users")
}

model AdminRequest {
  id           String             @id @default(cuid())
  email        String
  name         String?
  requestedBy  String?
  approvedById String?
  status       AdminRequestStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  company      String?
  description  String?
  approvedBy   User?              @relation("ApprovedAdminRequests", fields: [approvedById], references: [id])

  @@index([email])
  @@map("admin_requests")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  details      Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User     @relation("AuditActor", fields: [actorId], references: [id])
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model InviteLink {
  id              String    @id @default(cuid())
  token           String    @unique
  createdBy       String
  roleHint        UserRole?
  expiresAt       DateTime
  usedAt          DateTime?
  maxUses         Int       @default(1)
  useCount        Int       @default(0)
  maxStorageBytes Int?
  maxScans        Int?
  maxLocations    Int?
  createdAt       DateTime  @default(now())
  creator         User      @relation("InviteCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([expiresAt])
  @@map("invite_links")
}

model Location {
  id                 String               @id @default(cuid())
  userId             String
  adminId            String?
  name               String
  description        String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  admin              User?                @relation("AdminLocations", fields: [adminId], references: [id])
  user               User                 @relation("UserLocations", fields: [userId], references: [id], onDelete: Cascade)
  mappingPreferences MappingPreference[]
  mappings           Mapping[]
  presets            MappingPreset[]
  rules              Rule[]
  scanRecords        ScanRecord[]
  templates          Template[]
  products           Product[]
  attachments        LocationAttachment[]

  @@index([userId])
  @@index([adminId])
  @@map("locations")
}

model LocationAttachment {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String   @unique
  fileSize   Int
  mimeType   String
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())

  @@index([locationId])
  @@map("location_attachments")
}

model Template {
  id                String           @id @default(cuid())
  locationId        String
  name              String
  transactionType   String           @default("JOURNAL_ENTRY")
  lineType          String           @default("journal_entry")
  version           Int              @default(1)
  defaults          Json?
  columnMappings    Json?
  memoTemplate      String?
  docNumberTemplate String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  posSystem         String?
  scanModes         ScanMode[]       @default([IMAGE])
  mappings          Mapping[]
  productMappings   ProductMapping[]
  payeeMappings     PayeeMapping[]
  valueMappings     ValueMapping[]
  rules             Rule[]
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("templates")
}

model Mapping {
  id                String    @id @default(cuid())
  locationId        String
  sourceField       String
  targetAccount     String
  targetClass       String?
  targetName        String?
  targetDescription String?
  targetMemo        String?
  priority          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  keepSeparate      Boolean   @default(false)
  postingType       String    @default("Credit")
  templateId        String?
  conditions        Json?
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template          Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([templateId])
  @@map("mappings")
}

model MappingPreset {
  id          String    @id @default(uuid())
  name        String
  description String?
  isBuiltIn   Boolean   @default(false)
  industry    String?
  mappings    Json
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([locationId])
  @@index([isBuiltIn])
  @@map("mapping_presets")
}

model MappingPreference {
  id            String   @id @default(cuid())
  locationId    String
  sourceField   String
  accountId     String
  accountName   String
  timesAccepted Int      @default(1)
  lastUsedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, sourceField, accountId])
  @@index([locationId])
  @@index([sourceField])
  @@map("mapping_preferences")
}

model ProductMapping {
  id           String   @id @default(cuid())
  templateId   String
  productId    String
  accountId    String
  postingType  String   @default("Credit")
  classId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  matchingRule Json?
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, productId])
  @@index([templateId])
  @@index([productId])
  @@map("product_mappings")
}

model PayeeMapping {
  id           String   @id @default(cuid())
  templateId   String
  scannedName  String
  vendorId     String
  matchingRule Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, scannedName])
  @@index([templateId])
}

model ValueMapping {
  id           String   @id @default(cuid())
  templateId   String
  fieldType    String
  scannedText  String
  sourceField  String?
  entityId     String
  matchingRule Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  template     Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldType, sourceField, scannedText])
  @@index([templateId])
}

model Rule {
  id         String    @id @default(cuid())
  locationId String
  name       String
  ruleType   RuleType
  config     Json
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  templateId String?
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template   Template? @relation(fields: [templateId], references: [id])

  @@index([locationId])
  @@index([templateId])
  @@map("rules")
}

model ScanRecord {
  id              String       @id @default(cuid())
  locationId      String
  scanDate        DateTime
  rawData         Json
  status          ScanStatus   @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  rawScanEntry    Json?
  submittedById   String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  approvalNotes   String?
  source          String       @default("pos")
  transactionType String       @default("JOURNAL_ENTRY")
  autoAttach      Boolean      @default(true)
  syncStatus      ScanStatus   @default(PENDING)
  lastSyncError   String?
  location        Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  submittedBy     User?        @relation("ScanSubmitter", fields: [submittedById], references: [id])
  approvedBy      User?        @relation("ScanApprover", fields: [approvedById], references: [id])
  syncLogs        SyncLog[]
  attachments     Attachment[]

  @@index([locationId])
  @@index([status])
  @@index([createdAt])
  @@index([source])
  @@index([locationId, status])
  @@map("scan_records")
}

model Attachment {
  id           String     @id @default(cuid())
  scanRecordId String
  scanRecord   ScanRecord @relation(fields: [scanRecordId], references: [id], onDelete: Cascade)

  fileName   String
  storageKey String @unique
  fileSize   Int
  mimeType   String

  createdAt DateTime @default(now())

  @@index([scanRecordId])
}

model ScanPackPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packKey         String
  scans           Int
  pricePaid       Int
  stripeSessionId String   @unique
  status          String   @default("active")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([stripeSessionId])
}

model SyncLog {
  id               String      @id @default(cuid())
  scanRecordId     String?
  qbJournalEntryId String?
  status           SyncStatus
  errorMessage     String?
  syncedAt         DateTime    @default(now())
  docNumber        String?
  errorType        String?
  attemptCount     Int         @default(1)
  nextRetryAt      DateTime?
  retryInterval    Int?
  maxAttempts      Int         @default(5)
  retryCount       Int         @default(0)
  requestPayload   Json?
  requestHash      String?
  syncType         SyncType
  userId           String?
  scanRecord       ScanRecord? @relation(fields: [scanRecordId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scanRecordId])
  @@index([syncType, requestHash])
  @@index([userId, syncType, requestHash])
  @@index([userId, syncedAt])
  @@index([status, nextRetryAt])
  @@map("sync_logs")
}

model QBToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  realmId      String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stale        Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("qb_tokens")
}

model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([userId])
  @@map("oauth_states")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncFailureAlerts  Boolean  @default(true)
  quotaWarningAlerts Boolean  @default(true)
  teamChangeAlerts   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preferences")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  userId          String
  locationId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productMappings ProductMapping[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, name])
  @@index([userId])
  @@index([locationId])
  @@map("products")
}

model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("stripe_events")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
  IGNORED
}

model WebhookDeliveryLog {
  id           String                  @id @default(cuid())
  eventId      String?
  eventType    String
  status       WebhookDeliveryStatus
  statusCode   Int                     @default(200)
  errorMessage String?
  payload      Json?
  receivedAt   DateTime                @default(now())

  @@index([eventType])
  @@index([status])
  @@index([receivedAt])
  @@map("webhook_delivery_logs")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  EXPIRED
  DISABLED
  PENDING_APPROVAL
  GRACE_PERIOD
  TIME_BOMBED
  BLOCKED
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScanMode {
  IMAGE
  EXCEL
  POS
}

enum RuleType {
  COMBINE
  DEDUCT
  THRESHOLD
  FORMULA
}

enum ScanStatus {
  PENDING
  MAPPED
  SYNCED
  FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SyncStatus {
  SUCCESS
  FAILED
}

enum SyncType {
  JOURNAL_ENTRY
  BILL
  VENDOR_CREDIT
  CHEQUE
  BILL_PAYMENT
}
