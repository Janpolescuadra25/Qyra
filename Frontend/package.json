{
  "name": "qyra-extension",
  "version": "1.0.2",
  "private": true,
  "description": "Qyra Chrome Extension — Toast POS to QuickBooks sync",
  "scripts": {
    "build": "node scripts/build.js --browser=chrome",
    "build:watch": "node scripts/build.js --watch",
    "build:chrome": "node scripts/build.js --browser=chrome",
    "build:firefox": "node scripts/build.js --browser=firefox",
    "build:edge": "node scripts/build.js --browser=edge",
    "build:safari": "node scripts/build.js --browser=safari",
    "build:all": "node scripts/build.js --browser=all",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "package": "npm run build:chrome && node scripts/package.js",
    "package:all": "npm run build:all && node scripts/package.js"
  },
  "dependencies": {
    "@sentry/browser": "^11.4.0",
    "dotenv": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webextension-polyfill": "^0.12.6",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
